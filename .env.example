# ---------------------------------------------------------------- runtime
PORT=3000
NODE_ENV=development

# SQLite database file (directory is created automatically).
# In containers: /data/matchvision.db on a mounted volume.
DATABASE_PATH=./data/matchvision.db

# Set to "true" behind HTTPS so the session cookie is marked Secure.
COOKIE_SECURE=false

# Set to "true" when running behind a reverse proxy / load balancer.
TRUST_PROXY=false

# Public URL of the deployment (used in emails and absolute links).
APP_URL=http://localhost:3000

# Max JSON body size accepted by the API (match artefacts).
MAX_BODY_SIZE=10mb

# Admin-only code explorer and Python test runner. Disable in production.
ENABLE_CODE_EXPLORER=true

# ---------------------------------------------------------------- branding
SITE_NAME=MatchVision AI
COMPANY_NAME=MatchVision Labs Ltd
SUPPORT_EMAIL=support@matchvision.ai

# ------------------------------------------------------------ AI (optional)
# Without a key every AI endpoint returns a deterministic offline summary.
GEMINI_API_KEY=

# Real, GA Gemini model IDs available to your key.
GEMINI_TACTICAL_MODEL=gemini-2.5-pro
GEMINI_BROADCAST_MODEL=gemini-2.5-flash
GEMINI_LITE_MODEL=gemini-2.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
